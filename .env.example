# Copy to .env.local and fill in. Every variable MUST be prefixed with
# REACT_APP_ so Create React App inlines it into the client bundle. Restart
# `npm start` after editing.
#
# Find the Supabase values in your project: Settings → API
#   - Project URL                     → REACT_APP_SUPABASE_URL
#   - Project API keys → anon public  → REACT_APP_SUPABASE_ANON_KEY
#
# Find the Turnstile value at https://dash.cloudflare.com → Turnstile → your
# widget → Site Key.
#
# All three of these are PUBLIC and safe to ship in client code.
#
# NEVER put the Supabase service_role key or the Turnstile secret key here.
# Both live only in the verified-insert Edge Function's environment, set with
# `supabase secrets set`. Anything in this file ends up in the browser bundle.

REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Leave blank for local development: the Turnstile widget is skipped and writes
# fall back to localStorage only, exactly as they do without Supabase keys.
REACT_APP_TURNSTILE_SITE_KEY=
