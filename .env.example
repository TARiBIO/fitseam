# Copy to .env.local and fill in with your Supabase project keys.
# Both variables MUST be prefixed with REACT_APP_ so Create React App inlines
# them into the client bundle. Restart `npm start` after editing.
#
# Find these in your Supabase project: Settings → API
#   - Project URL           → REACT_APP_SUPABASE_URL
#   - Project API keys → anon public  → REACT_APP_SUPABASE_ANON_KEY
#
# The anon key is safe to ship in client code. Row Level Security policies
# (see supabase/schema.sql) enforce what the anon role can read and write.
# NEVER put the service_role key here — it bypasses RLS.

REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
